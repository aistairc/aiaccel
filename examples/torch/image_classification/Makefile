available_modes := single ddp
mode ?= single

ifeq ($(filter $(mode),$(available_modes)),)
$(error Unsupported mode '$(mode)'. Choose one of: $(available_modes))
endif

include $(mode).mk

.DEFAULT_GOAL := help

workflow_template ?= aiaccel-workflow template
STAGES_MK := $(shell $(workflow_template) stages.mk)
TRAIN_MK := $(shell $(workflow_template) train.mk)

recipe_root ?= ./recipes
experiment := $(patsubst %/config.yaml,%,$(recipe))
recipe_path := $(recipe_root)/$(recipe)
train_path ?= ./runs/$(subst /,_,$(experiment))
data_root ?= ./data
walltime ?= 1:0:0
env_activate_command ?= $(if $(VIRTUAL_ENV),source $(VIRTUAL_ENV)/bin/activate,)

cmd ?= aiaccel-job pbs --config $(train_path)/config.yaml
job_ops ?=

min_stage := 1
max_stage := 3
train_ready_stage := 2

stage1_description := prepare the training directory and CIFAR-10
stage2_description := generate config.yaml with workflow overrides
stage3_description := launch training with aiaccel-job

stage1_dependencies := $(train_path)/.prepare.done
stage2_dependencies := $(train_path)/.config.done
stage3_dependencies := $(train_path)/.train.done

PRINT_VARIABLES := \
	mode \
	recipe \
	recipe_path \
	train_path \
	data_root \
	n_gpus \
	walltime \
	env_activate_command \
	cmd \
	job_ops

.PHONY: single ddp config train clean

single:
	$(MAKE) all mode=single

ddp:
	$(MAKE) all mode=ddp

config: stage2

train: stage3

$(train_path)/.prepare.done:
	mkdir -p $(train_path)
	python ./prepare_dataset.py $(abspath $(data_root))
	touch $@

$(train_path)/config.yaml: $(recipe_path) | $(train_path)/.prepare.done
	printf '%s\n' \
		"# Generated by examples/torch/image_classification/Makefile" \
		"_base_: $(abspath $(recipe_path))" \
		"n_gpus: $(n_gpus)" \
		"walltime: \"$(walltime)\"" \
		"env_activate_command: '$(env_activate_command)'" > $@

$(train_path)/.config.done: $(train_path)/config.yaml
	touch $@

clean:
	rm -r $(train_path)

include $(STAGES_MK)
include $(TRAIN_MK)
